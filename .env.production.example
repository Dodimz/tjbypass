# =============================================================
# Template environment PRODUCTION (Docker).
# Salin di VPS menjadi:  cp .env.production.example .env.production
# lalu isi semua nilai <ISI_INI>.
# JANGAN pernah commit file asli (.env.production sudah di-gitignore).
# =============================================================

APP_NAME=MentorLMS
APP_ENV=production
APP_DEBUG=false
# Generate unik sekali saja, jangan pakai contoh dari mana pun:
#   php artisan key:generate --show
APP_KEY=<ISI_INI_dengan_base64_baru>
APP_URL=https://<domain-anda.com>
APP_TIMEZONE='Asia/Jakarta'

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (harus cocok dengan docker/env/mysql.prod.env) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mentor_lms_prod
DB_USERNAME=mentor_lms_user
DB_PASSWORD=<ISI_INI_sama_dengan_MYSQL_PASSWORD>

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=<domain-anda.com>

MEDIA_DISK=public
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=<smtp-provider-anda>
MAIL_PORT=587
MAIL_USERNAME=<user-smtp>
MAIL_PASSWORD=<password-smtp>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@<domain-anda.com>"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

NOCAPTCHA_SECRET=
NOCAPTCHA_SITEKEY=

# Domain yang dipercaya untuk stateful request (API/Sanctum)
SANCTUM_STATEFUL_DOMAINS=<domain-anda.com>

# Trusted proxies (isi bila ada reverse proxy di depan nginx)
TRUSTED_PROXIES=
